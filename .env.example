# ─────────────────────────────────────────────────────────────────────────────
# React Observability Demo — environment
#
# Copy to `.env` and adjust. `npm run dev` reads it automatically.
#
# ONE env var is the whole integration. Leave it empty and the app still runs
# perfectly — it just reports "export disabled" in the Observability panel
# instead of shipping spans to a backend.
# ─────────────────────────────────────────────────────────────────────────────

# Base OTLP/HTTP endpoint. The app appends /v1/traces, /v1/metrics and /v1/logs.
#
#   Local OTEL-LGTM (docker compose up -d)      http://localhost:4318
#   Grafana Cloud OTLP gateway                  https://otlp-gateway-<zone>.grafana.net/otlp
#
VITE_OTLP_ENDPOINT=http://localhost:4318

# Optional. Comma-separated key=value pairs sent as OTLP headers.
# Required for Grafana Cloud, which authenticates with Basic auth (instance ID : API token).
#   VITE_OTLP_HEADERS=Authorization=Basic <base64(instanceId:token)>
#
# NOTE: this is a browser bundle. Anything here is readable by anyone who loads
# the page. Use a write-only, ingest-scoped token and nothing else.
VITE_OTLP_HEADERS=

# Resource attributes attached to every span, metric and log record.
VITE_SERVICE_NAME=react-observability-demo

# Left commented on purpose. The version is injected at build time from
# package.json, so setting it here would pin a literal that silently goes stale
# on the next release. Uncomment only to report a different version deliberately.
# VITE_SERVICE_VERSION=0.1.0

VITE_DEPLOYMENT_ENVIRONMENT=development

# Head sampling ratio for traces, 0..1.
VITE_TRACES_SAMPLE_RATE=1

# How often the metrics pipeline exports, in milliseconds.
VITE_METRIC_EXPORT_INTERVAL=10000

# Optional. Shown as an "Open in Grafana" link in the header.
#   Local:          http://localhost:3000
#   Grafana Cloud:  https://<your-stack>.grafana.net
VITE_GRAFANA_URL=http://localhost:3000
